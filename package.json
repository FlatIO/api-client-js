{
  "name": "flat-api",
  "version": "1.0.1",
  "description": "The official JavaScript and TypeScript client for the Flat API",
  "author": "Flat <developers@flat.io>",
  "repository": {
    "type": "git",
    "url": "https://github.com/FlatIO/api-client-js.git"
  },
  "keywords": [
    "flat",
    "music-notation",
    "openapi-client",
    "openapi-generator",
    "typescript",
    "flat-api"
  ],
  "license": "Apache-2.0",
  "files": [
    "dist",
    "CHANGELOG.md",
    "MIGRATION.md",
    "QUICKSTART.md"
  ],
  "main": "./dist/index.js",
  "typings": "./dist/index.d.ts",
  "module": "./dist/esm/index.js",
  "sideEffects": false,
  "scripts": {
    "build": "tsc && tsc -p tsconfig.esm.json && node tools/mark-esm-build.mjs",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@8.15.9"
}
